---
import "@fontsource-variable/archivo";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";

import { languages, type Lang } from "../i18n/ui";
import { useTranslations, localizePath, withBase } from "../i18n/utils";

interface Props {
  lang: Lang;
  /** Locale-neutral path of the current page, e.g. "/gala/". Defaults to the homepage. */
  path?: string;
  /** Overrides for a page other than the homepage. */
  title?: string;
  description?: string;
}

const { lang, path = "/", title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ?? t("meta.title");
const pageDescription = description ?? t("meta.description");

const canonical = new URL(localizePath(path, lang), Astro.site);
const ogImage = new URL(withBase("/og.jpg"), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />

    {
      /* Tell search engines the three pages are translations of each other,
         not duplicates competing with one another. */
      (Object.keys(languages) as Lang[]).map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localizePath(path, l), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(withBase(path), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#16303f" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
  </head>

  <body class="bg-paper">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t("nav.skip")}
    </a>
    <slot />
  </body>
</html>
