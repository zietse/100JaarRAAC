---
import Base from "./Base.astro";
import Footer from "../components/Footer.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localizePath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base
  lang={lang}
  path="/gala/"
  title={t("gala.meta.title")}
  description={t("gala.meta.description")}
>
  <header class="bg-brand text-white">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-10 gap-y-4 px-6 py-5"
    >
      <a
        href={localizePath("/", lang)}
        class="text-sm font-semibold text-white/75 transition-colors hover:text-white"
      >
        ← {t("gala.back")}
      </a>
      <LangSwitcher lang={lang} tone="dark" path="/gala/" />
    </div>
  </header>

  <main id="main">
    <section class="bg-brand pb-16 text-white">
      <div class="mx-auto max-w-6xl px-6 pt-10">
        <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
          {t("gala.eyebrow")}
        </p>
        <h1
          class="mt-4 text-[clamp(2.25rem,7vw,4.5rem)] leading-[0.95] font-black tracking-[-0.03em]"
        >
          {t("gala.heading")}
        </h1>
        <p class="mt-5 max-w-[42ch] text-xl font-semibold text-white/80">
          {t("gala.tagline")}
        </p>
      </div>
    </section>

    <section class="bg-surface py-20">
      <div class="mx-auto max-w-3xl px-6 text-lg">
        <p class="font-medium text-balance">{t("gala.intro.p1")}</p>
        <p class="mt-5 text-muted">{t("gala.intro.p2")}</p>

        <p
          class="mt-8 max-w-[52ch] border-l-4 border-accent bg-surface-alt py-4 pr-5 pl-5 text-sm text-muted"
        >
          {t("gala.fact.body")}
        </p>

        <p class="mt-8 font-medium">{t("gala.intro.p3")}</p>
      </div>
    </section>

    <section class="bg-brand py-20 text-white">
      <div class="mx-auto max-w-4xl px-6">
        <p
          class="text-[clamp(1.75rem,5.5vw,3.25rem)] leading-[1.05] font-black text-balance"
        >
          {t("gala.people.quote")}
        </p>
      </div>
    </section>

    <section class="bg-surface-alt py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-[clamp(1.5rem,4vw,2.25rem)]">
          {t("gala.people.heading")}
        </h2>
        <div class="mt-5 space-y-4 text-lg">
          <p>{t("gala.people.p1")}</p>
          <p class="text-muted">{t("gala.people.p2")}</p>
        </div>
      </div>
    </section>

    <section class="bg-surface py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-[clamp(1.5rem,4vw,2.25rem)]">
          {t("gala.setting.heading")}
        </h2>
        <div class="mt-5 space-y-4 text-lg">
          <p>{t("gala.setting.p1")}</p>
          <p>{t("gala.setting.p2")}</p>
        </div>
      </div>
    </section>

    <section class="bg-brand py-20 text-white">
      <div class="mx-auto max-w-3xl px-6 text-center">
        <h2 class="text-[clamp(1.75rem,5vw,3rem)] font-black">
          {t("gala.heading")}
        </h2>
        <p class="mt-2 text-lg text-white/70">{t("gala.closing.date")}</p>
        <p class="mt-8 text-2xl font-bold">{t("gala.closing.cta1")}</p>
        <p class="mt-2 text-white/60">{t("gala.closing.cta2")}</p>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</Base>
