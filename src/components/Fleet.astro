---
import type { Lang } from "../i18n/ui";
import { useTranslations, withBase } from "../i18n/utils";
import { fleet } from "../data/fleet";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="fleet" class="border-b border-line bg-surface py-24">
  <div class="mx-auto max-w-6xl px-6">
    <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
      {t("track.club")}
    </p>
    <h2 class="mt-3 text-[clamp(1.75rem,5vw,3rem)]">{t("fleet.heading")}</h2>
    <p class="mt-5 max-w-[46rem] text-lg text-muted">{t("fleet.lede")}</p>

    <ul
      class="mt-10 grid list-none grid-cols-[repeat(auto-fill,minmax(14rem,1fr))] gap-[1.1rem] p-0"
    >
      {
        fleet.map((aircraft) => (
          <li class="flex flex-col overflow-hidden rounded-[18px] border border-line bg-surface">
            <figure class="m-0 aspect-[3/2] bg-surface-alt">
              <img
                src={withBase(aircraft.image)}
                alt={aircraft.name}
                loading="lazy"
                decoding="async"
                tabindex="0"
                data-zoom
                class="block h-full w-full cursor-zoom-in object-cover"
              />
            </figure>
            <div class="px-[1.1rem] pt-[0.9rem] pb-[1.1rem]">
              <p class="text-[1.4rem] leading-none font-extrabold text-brand tabular-nums">
                {aircraft.year}
              </p>
              <h3 class="mt-2 text-[1.05rem] leading-tight font-extrabold">
                {aircraft.name}
              </h3>
              <p class="mt-1 text-sm leading-snug text-muted">
                {aircraft.body[lang]}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-[62ch] text-sm text-muted">{t("fleet.note")}</p>
  </div>
</section>
