---
import type { Lang } from "../i18n/ui";
import { useTranslations, withBase } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="top" class="bg-brand pb-16 text-white">
  <div class="mx-auto max-w-6xl px-6">
    {/* The 50/50 split. Below lg the two cells stack, because at half of a
        narrow viewport neither the title nor the crest has room to work. */}
    <div class="grid items-center gap-x-12 gap-y-10 pt-10 lg:grid-cols-2">
      <div>
        <p class="text-sm font-bold tracking-[0.14em] text-accent uppercase">
          {t("hero.years")}
        </p>
        <h1 class="mt-3 leading-[0.92]">
          <span class="block text-[clamp(2.75rem,8.5vw,6.5rem)] font-black tracking-[-0.04em]">
            {t("hero.title")}
          </span>
          <span class="mt-3 block text-[clamp(1.1rem,3.6vw,2rem)] font-semibold tracking-tight text-white/70">
            {t("hero.subtitle")}
          </span>
        </h1>
        <p class="mt-6 max-w-[42ch] text-lg text-white/80">{t("hero.intro")}</p>
      </div>

      {/* Decorative: the club name is already in the header, so announcing
          the crest again would be noise. */}
      <img
        src={withBase("/resources/RAAC_Logo_Good.png")}
        alt=""
        loading="eager"
        decoding="async"
        class="h-auto w-[clamp(14rem,30vw,26rem)] justify-self-start lg:justify-self-end"
      />
    </div>

    <a
      href="#events"
      class="no-print mt-14 inline-block rounded-full bg-accent px-8 py-4 text-base font-bold text-white transition-transform hover:scale-[1.02]"
    >
      {t("hero.cta")}
    </a>
  </div>
</section>
