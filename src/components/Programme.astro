---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="programme" class="bg-surface py-24">
  <div class="mx-auto max-w-3xl px-6">
    <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
      {t("flyin.eyebrow")}
    </p>
    <h2 class="mt-3 text-[clamp(1.75rem,5vw,3rem)]">{t("flyin.heading")}</h2>
    <p class="mt-3 text-xl font-semibold text-muted">{t("flyin.tagline")}</p>

    <div class="mt-10 space-y-4 text-lg">
      <p class="font-medium text-balance">{t("flyin.intro.p1")}</p>
      <p>{t("flyin.intro.p2")}</p>
      <p class="text-muted">{t("flyin.intro.p3")}</p>
    </div>

    <div class="mt-14 border-t border-line pt-10">
      <h3 class="text-xl font-bold">{t("flyin.stampe.heading")}</h3>
      <div class="mt-4 space-y-4">
        <p>{t("flyin.stampe.p1")}</p>
        <p class="text-muted">{t("flyin.stampe.p2")}</p>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-10">
      <h3 class="text-xl font-bold">{t("flyin.sky.heading")}</h3>
      <div class="mt-4 space-y-4">
        <p>{t("flyin.sky.p1")}</p>
        <p class="text-muted">{t("flyin.sky.p2")}</p>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-10">
      <h3 class="text-xl font-bold">{t("flyin.behind.heading")}</h3>
      <div class="mt-4 space-y-4">
        <p>{t("flyin.behind.p1")}</p>
        <p class="text-muted">{t("flyin.behind.p2")}</p>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-10">
      <h3 class="text-xl font-bold">{t("flyin.neighbours.heading")}</h3>
      <p class="mt-4 text-muted">{t("flyin.neighbours.p1")}</p>
    </div>

    <div class="mt-16 rounded-2xl bg-brand px-8 py-10 text-center text-white">
      <h3 class="text-[clamp(1.4rem,4vw,2rem)] font-black">
        {t("flyin.closing.heading")}
      </h3>
      <p class="mt-4 text-white/80">{t("flyin.closing.body")}</p>
      <p class="mt-6 text-xl font-bold">{t("flyin.closing.cta")}</p>
      <p class="mt-1 text-sm text-white/60">{t("flyin.closing.note")}</p>
    </div>
  </div>
</section>
