---
import type { Lang, UIKey } from "../i18n/ui";
import { useTranslations, localizePath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

type Tile = {
  date: UIKey;
  title: UIKey;
  body: UIKey;
  cta: UIKey;
  href: string;
  badge?: UIKey;
};

const tiles: Tile[] = [
  {
    date: "events.flyin.date",
    title: "events.flyin.title",
    body: "events.flyin.body",
    cta: "events.flyin.cta",
    href: "#programme",
  },
  {
    date: "events.gala.date",
    title: "events.gala.title",
    body: "events.gala.body",
    cta: "events.gala.cta",
    href: localizePath("/gala/", lang),
  },
  {
    date: "events.finale.date",
    title: "events.finale.title",
    body: "events.finale.body",
    cta: "events.finale.cta",
    href: "#finale",
    badge: "events.finale.badge",
  },
];
---

<section id="events" class="bg-surface-alt py-24">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="text-[clamp(1.75rem,5vw,3rem)]">{t("events.heading")}</h2>
    <p class="mt-5 max-w-[60ch] text-xl text-muted">{t("events.intro")}</p>

    <ul class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        tiles.map((tile) => (
          <li class="flex flex-col rounded-2xl border border-line bg-surface p-7">
            {tile.badge && (
              <span class="mb-3 inline-block w-fit rounded-full bg-accent px-3 py-1 text-xs font-bold tracking-[0.1em] text-white uppercase">
                {t(tile.badge)}
              </span>
            )}
            <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase">
              {t(tile.date)}
            </p>
            <h3 class="mt-2 text-xl font-bold">{t(tile.title)}</h3>
            <p class="mt-3 flex-1 text-muted">{t(tile.body)}</p>
            <a
              href={tile.href}
              class="mt-6 inline-flex items-center gap-1.5 text-sm font-bold text-accent"
            >
              {t(tile.cta)}
              <svg
                class="w-3.5"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8 H13 M9 4 L13 8 L9 12" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
