---
import type { Lang, UIKey } from "../i18n/ui";
import { useTranslations, withBase } from "../i18n/utils";
import { timeline, type Track } from "../data/timeline";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const tracks: Track[] = ["club", "airport", "city"];

/* A vertical list of cards on one axis, coloured by track. The filter
   buttons only appear once the script runs; without JavaScript every entry
   simply stays visible. Photos open enlarged through Zoom.astro. */
---

<section id="timeline" class="bg-surface-alt py-24">
  <div class="mx-auto max-w-6xl px-6" data-timeline>
    <p class="text-xs font-bold tracking-[0.14em] text-accent uppercase tabular-nums">
      {t("history.eyebrow")}
    </p>
    <h2 class="mt-3 text-[clamp(1.75rem,5vw,3rem)]">{t("history.heading")}</h2>
    <p class="mt-5 max-w-[52ch] text-xl text-muted">{t("history.lede")}</p>

    <div
      class="filters no-print"
      role="group"
      aria-label={t("history.filter.label")}
      data-timeline-filters
      hidden
    >
      <button type="button" data-filter="all" aria-pressed="true">
        {t("history.filter.all")}
      </button>
      {
        tracks.map((track) => (
          <button type="button" data-filter={track} aria-pressed="false">
            {t(`track.${track}` as UIKey)}
          </button>
        ))
      }
    </div>

    <ol class="tl">
      {
        timeline.map((entry) => {
          const photos = entry.images ?? [];
          return (
            <li
              class:list={["ev", entry.landmark && "is-landmark"]}
              data-track={entry.track}
            >
              <span class="ev-year tabular-nums">{entry.year}</span>
              <span class="ev-dot" aria-hidden="true" />
              <article class:list={["ev-card", photos.length > 0 && "has-photo"]}>
                {photos.length > 0 && (
                  <figure class="ev-photos">
                    {photos.slice(0, 2).map((photo) => (
                      <img
                        src={withBase(photo.src)}
                        alt={photo.alt ? photo.alt[lang] : entry.title[lang]}
                        loading="lazy"
                        decoding="async"
                        tabindex="0"
                        data-zoom
                      />
                    ))}
                  </figure>
                )}
                <div class="ev-text">
                  <span class="ev-tag">{t(`track.${entry.track}` as UIKey)}</span>
                  <h3 class="mt-2 text-lg leading-tight font-extrabold">
                    {entry.title[lang]}
                    {entry.verify && (
                      <sup class="verify" title={t("history.verify")}>
                        *
                      </sup>
                    )}
                  </h3>
                  <p class="mt-1 font-archive text-[0.95rem] leading-relaxed text-muted">
                    {entry.body[lang]}
                  </p>
                </div>
              </article>
            </li>
          );
        })
      }
    </ol>

    <p class="mt-8 max-w-[62ch] text-sm text-muted">
      <sup class="verify">*</sup>
      {t("history.verify")}
      {t("history.note")}
    </p>
  </div>
</section>

<style>
  [data-timeline] {
    --year-col: 5.4rem;
    --dot-col: 2rem;
    --gap: 0.6rem;
  }

  @media (max-width: 620px) {
    [data-timeline] {
      --year-col: 3rem;
      --dot-col: 1.4rem;
    }
  }

  /* ---- Filters ------------------------------------------------------ */

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.6rem 0 2.4rem;
  }

  .filters[hidden] {
    display: none;
  }

  .filters button {
    padding: 0.5rem 1.1rem;
    border: 2px solid var(--color-brand);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-brand);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  .filters button[aria-pressed="true"] {
    background: var(--color-brand);
    color: white;
  }

  /* ---- Axis and rows ------------------------------------------------ */

  .tl {
    position: relative;
    margin: 2.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* With the filters showing, they already provide the space above. */
  .filters:not([hidden]) + .tl {
    margin-top: 0;
  }

  /* The axis runs through the centre of the dot column. */
  .tl::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--year-col) + var(--gap) + var(--dot-col) / 2 - 1.5px);
    width: 3px;
    background: var(--color-line);
  }

  .ev {
    display: grid;
    grid-template-columns: var(--year-col) var(--dot-col) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
    margin-bottom: 1.1rem;
  }

  .ev[hidden] {
    display: none;
  }

  .ev[data-track="club"] {
    --c: var(--color-brand);
  }
  .ev[data-track="airport"] {
    --c: var(--color-accent);
  }
  .ev[data-track="city"] {
    --c: var(--color-city);
  }

  .ev-year {
    padding-top: 1.1rem;
    font-size: 1rem;
    font-weight: 900;
    color: var(--color-brand);
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 620px) {
    .ev-year {
      font-size: 0.8rem;
    }
  }

  .ev-dot {
    position: relative;
    z-index: 1;
    width: 15px;
    height: 15px;
    margin: 1.3rem auto 0;
    border: 3px solid var(--color-surface);
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 2px var(--c);
  }

  .ev.is-landmark .ev-dot {
    width: 21px;
    height: 21px;
    margin-top: 1.1rem;
  }

  /* ---- Card --------------------------------------------------------- */

  .ev-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: var(--color-surface);
  }

  .ev-card.has-photo {
    grid-template-columns: minmax(150px, 230px) minmax(0, 1fr);
  }

  /* One photo fills the column; two share it, stacked. */
  .ev-photos {
    display: grid;
    grid-auto-rows: 1fr;
    gap: 2px;
    min-height: 175px;
    margin: 0;
    background: var(--color-surface-alt);
  }

  .ev-photos img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    cursor: zoom-in;
  }

  .ev-text {
    padding: 1.1rem 1.4rem;
  }

  .ev-tag {
    display: inline-block;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: var(--c);
    color: white;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .verify {
    margin-inline-start: 0.1em;
    color: var(--color-accent);
    font-weight: 900;
    cursor: help;
  }

  @media (max-width: 620px) {
    .ev-card.has-photo {
      grid-template-columns: minmax(0, 1fr);
    }
    .ev-photos {
      grid-auto-rows: auto;
      grid-auto-flow: column;
      min-height: 0;
      height: 190px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .filters button {
      transition: none;
    }
  }

  @media print {
    .ev[hidden] {
      display: grid;
    }
    .ev {
      break-inside: avoid;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-timeline]")) {
    const group = root.querySelector<HTMLElement>("[data-timeline-filters]");
    if (!group) continue;

    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>("button"));
    const entries = Array.from(root.querySelectorAll<HTMLElement>(".ev"));

    const apply = (filter: string) => {
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.filter === filter)),
      );
      entries.forEach((e) => {
        e.hidden = filter !== "all" && e.dataset.track !== filter;
      });
    };

    group.hidden = false;
    buttons.forEach((b) =>
      b.addEventListener("click", () => apply(b.dataset.filter ?? "all")),
    );

    // "Only the airport →" style links elsewhere on the page.
    document
      .querySelectorAll<HTMLElement>("[data-timeline-filter]")
      .forEach((link) =>
        link.addEventListener("click", () =>
          apply(link.dataset.timelineFilter ?? "all"),
        ),
      );
  }
</script>
