---
import type { Lang } from "../i18n/ui";
import { useTranslations, withBase } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="bg-surface py-24">
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-[minmax(0,1fr)_auto]"
  >
    <div>
      <h2 class="max-w-[16ch] text-[clamp(2rem,6vw,3.75rem)]">
        {t("about.heading")}
      </h2>
      <p class="mt-8 max-w-[60ch] text-xl text-muted">{t("about.body")}</p>
    </div>

    {/* Decorative: the club's Diamond, OO-MAV. */}
    <img
      src={withBase("/resources/Diamond_MAV.png")}
      alt=""
      loading="lazy"
      decoding="async"
      class="h-auto w-full max-w-[32rem] -rotate-3 justify-self-center lg:w-[min(32rem,40vw)]"
    />
  </div>
</section>
