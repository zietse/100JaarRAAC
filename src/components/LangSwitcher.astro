---
import { languages, type Lang } from "../i18n/ui";
import { useTranslations, localizePath } from "../i18n/utils";
import Flag from "./Flag.astro";

interface Props {
  lang: Lang;
  /** "dark" for the brand-coloured bands, "light" on white. */
  tone?: "dark" | "light";
  /** The footer sits at the bottom of the page, so its menu opens upward. */
  placement?: "down" | "up";
}
const { lang, tone = "light", placement = "down" } = Astro.props;
const t = useTranslations(lang);
const codes = Object.keys(languages) as Lang[];

/* Built on <details>, so it opens and closes with no JavaScript at all.
   The script below only adds what <details> lacks: Escape, outside click,
   and closing any other switcher that happens to be open. */
---

<details
  class:list={["lang", `lang--${tone}`, `lang--${placement}`]}
  data-lang-switcher
>
  <summary aria-label={`${t("lang.label")}: ${languages[lang]}`}>
    <Flag code={lang} />
    <span class="lang-code">{lang}</span>
    <svg
      class="lang-chevron"
      viewBox="0 0 10 6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M1 1 L5 5 L9 1" />
    </svg>
  </summary>

  <ul class="lang-menu">
    {
      codes.map((code) => (
        <li>
          <a
            href={localizePath("/", code)}
            hreflang={code}
            lang={code}
            aria-current={code === lang ? "true" : undefined}
          >
            <Flag code={code} />
            <span>{languages[code]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Open menus have to sit above the section that follows. */
  .lang[open] {
    z-index: 60;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    list-style: none;
    user-select: none;
    transition:
      background-color 120ms ease,
      color 120ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .lang-code {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .lang-chevron {
    width: 0.6rem;
    transition: transform 140ms ease;
  }

  .lang[open] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    inset-inline-end: 0;
    min-width: 11rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    box-shadow: 0 12px 28px -12px rgb(0 0 0 / 0.35);
  }

  .lang--down .lang-menu {
    top: calc(100% + 0.5rem);
  }

  .lang--up .lang-menu {
    bottom: calc(100% + 0.5rem);
  }

  .lang-menu a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--color-body);
    text-decoration: none;
    white-space: nowrap;
  }

  .lang-menu a:hover {
    background: var(--color-surface-alt);
  }

  .lang-menu a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .lang-menu a[aria-current] {
    color: var(--color-accent);
  }

  /* Trigger colours differ per band; the menu itself stays on white. */
  .lang--light summary {
    color: var(--color-muted);
  }
  .lang--light summary:hover,
  .lang--light[open] summary {
    color: var(--color-body);
    background: var(--color-surface-alt);
  }

  .lang--dark summary {
    color: rgb(255 255 255 / 0.75);
  }
  .lang--dark summary:hover,
  .lang--dark[open] summary {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    .lang-chevron {
      transition: none;
    }
  }
</style>

<script>
  const switchers = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("[data-lang-switcher]"),
  );

  for (const details of switchers) {
    // Only one open at a time.
    details.addEventListener("toggle", () => {
      if (!details.open) return;
      for (const other of switchers) {
        if (other !== details) other.open = false;
      }
    });
  }

  function closeAll(refocus: HTMLDetailsElement | null = null) {
    for (const details of switchers) details.open = false;
    refocus?.querySelector("summary")?.focus();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (switchers.some((details) => details.contains(target))) return;
    closeAll();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const open = switchers.find((details) => details.open);
    if (open) closeAll(open);
  });
</script>